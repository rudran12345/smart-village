# Database Connection String
# On Render / PostgreSQL: postgresql://<user>:<password>@<host>:5432/<dbname>
# For local dev without Postgres, fallback to sqlite:///./smart_village.db is supported
DATABASE_URL=postgresql://smart_village_user:secretpassword@dpg-xxxx.render.com/smart_village

# Allowed CORS Origins (comma-separated or * for public APIs)
CORS_ORIGINS=*

# Server Port
PORT=8000

# App Environment
ENVIRONMENT=production
